PORT=3000
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d
LOG_RETENTION_HOURS=24
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# Database adapter (libsql is the only supported adapter currently)
DB_ADAPTER=libsql

# Turso (cloud): libsql://<db-name>-<org>.turso.io
# Local SQLite (dev only): file:./data/logs.db
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── Ingestion ────────────────────────────────────────────────────────────────
# Max request/datagram body accepted on /logs
INGEST_BODY_LIMIT=10mb
# Max events in a single batch (json_array elements / ndjson lines)
MAX_BATCH_SIZE=1000
# Hostname shown in dashboard snippets; falls back to the request host
# PUBLIC_INGEST_HOST=logs.example.com

# ── UDP listener ─────────────────────────────────────────────────────────────
# Master switch for UDP collectors
UDP_ENABLED=true
# Address the listener binds to inside the container
UDP_BIND_HOST=0.0.0.0
# Allowed port range for UDP collectors (must be >1024: the container runs non-root)
UDP_PORT_RANGE=10000-10010
# How many UDP listeners may be active at once across the whole server
UDP_MAX_LISTENERS=1
# Datagrams larger than this are dropped (65507 = max UDP payload)
UDP_MAX_PACKET_BYTES=65507
# In-memory backpressure queue before datagrams are dropped
UDP_QUEUE_SIZE=5000
# Events coalesced into a single DB transaction while draining
UDP_DRAIN_BATCH=200
# How often DB collector rows are reconciled with live sockets
UDP_RECONCILE_INTERVAL_MS=60000

# NOTE: Render does not route inbound UDP to web services. The socket binds and
# the pipeline works (POST /collectors/:id/test proves it), but external
# datagrams will not arrive. For real UDP ingestion run on Docker/a VPS, or use
# tools/udp-forwarder next to your log source.
