{
  "name": "logbase",
  "version": "1.0.0",
  "description": "Logbase — log ingestion, full-text search, and management UI",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:raw": "node src/server.js",

    "setup": "./scripts/setup.sh",
    "dev": "./scripts/dev.sh --watch",
    "local": "./scripts/dev.sh",
    "local:fresh": "./scripts/dev.sh --fresh",

    "check": "./scripts/check.sh",
    "test": "./scripts/test.sh",
    "ci": "./scripts/ci.sh",

    "db:status": "./scripts/db.sh status",
    "db:backup": "./scripts/db.sh backup",
    "db:reset": "./scripts/db.sh reset",
    "db:console": "./scripts/db.sh console",

    "docker:up": "./scripts/docker.sh up",
    "docker:down": "./scripts/docker.sh down",
    "docker:logs": "./scripts/docker.sh logs",
    "docker:status": "./scripts/docker.sh status",

    "deploy:check": "./scripts/deploy.sh",
    "deploy": "./scripts/deploy.sh --push",

    "udp-forwarder": "node tools/udp-forwarder/index.js"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
